{
  "architecture": "0.11",
  "core": {
    "name": "pey.core",
    "version": "0.2.0"
  },
  "adapters": {
    "router": "HashHistoryAdapter",
    "storage": "IndexedDBAdapter"
  },
  "ui": {
    "path": "./ui"
  },
  "plugins": [
    {
      "name": "pey.storage",
      "version": "0.5.0",
      "path": "./plugins/pey.storage"
    },
    {
      "name": "pey.router",
      "version": "1.1.0",
      "path": "./plugins/pey.router"
    },
    {
      "name": "shirazeh.http",
      "version": "0.1.0",
      "path": "./plugins/shirazeh.http"
    },
    {
      "name": "pey.markdown",
      "version": "1.1.0",
      "path": "./plugins/pey.markdown"
    },
    {
      "name": "shirazeh.docs",
      "version": "0.3.0",
      "path": "./plugins/shirazeh.docs"
    },
    {
      "name": "shirazeh.prefs",
      "version": "0.1.0",
      "path": "./plugins/shirazeh.prefs"
    }
  ],
  "config": {
    "pey.router": {
      "basePath": "/",
      "notFoundPath": "/not-found"
    },
    "shirazeh.http": {
      "acceptedMediaTypes": [
        "text/markdown",
        "text/plain",
        "text/html"
      ],
      "timeoutMs": 15000
    },
    "pey.markdown": {
      "maxInputChars": 200000,
      "allowExternalImages": true
    },
    "shirazeh.docs": {
      "docsRoot": "./docs",
      "homePage": "README.md",
      "sidebarFile": "_sidebar.md",
      "notFoundPage": "not-found.md",
      "navbarFile": "config/navbar.md"
    },
    "ui": {
      "theme": "light",
      "language": "fa",
      "direction": "rtl",
      "fallbackPath": "/",
      "assetBaseUrl": "./assets"
    },
    "defaultLanguage": "fa",
    "pey.storage": {
      "databaseName": "shirazeh-db",
      "schemaVersion": 1,
      "stores": [
        {
          "name": "prefs",
          "keyPath": "key"
        }
      ]
    }
  },
  "app": {
    "name": "شیرازه",
    "version": "0.5.0"
  }
}

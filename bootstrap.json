{
  "architecture": "0.11",
  "core": {
    "name": "pey.core",
    "version": "0.2.0"
  },
  "adapters": {
    "router": "HashHistoryAdapter"
  },
  "ui": {
    "path": "./ui"
  },
  "plugins": [
    {
      "name": "pey.router",
      "version": "1.1.0",
      "path": "./plugins/pey.router"
    },
    {
      "name": "shirazeh.http",
      "version": "1.0.0",
      "path": "./plugins/shirazeh.http"
    },
    {
      "name": "pey.markdown",
      "version": "1.1.0",
      "path": "./plugins/pey.markdown"
    },
    {
      "name": "shirazeh.docs",
      "version": "1.0.0",
      "path": "./plugins/shirazeh.docs"
    }
  ],
  "config": {
    "pey.router": {
      "basePath": "/",
      "notFoundPath": "/not-found"
    },
    "shirazeh.http": {
      "acceptedMediaTypes": ["text/markdown", "text/plain", "text/html"],
      "timeoutMs": 15000
    },
    "pey.markdown": {
      "maxInputChars": 200000,
      "allowExternalImages": true
    },
    "shirazeh.docs": {
      "docsRoot": "./docs",
      "homePage": "README.md",
      "sidebarFile": "_sidebar.md"
    },
    "ui": {
      "theme": "light",
      "language": "fa",
      "direction": "rtl",
      "fallbackPath": "/",
      "assetBaseUrl": "./assets"
    },
    "defaultLanguage": "fa"
  },
  "app": {
    "name": "شیرازه",
    "version": "1.0.0"
  }
}
